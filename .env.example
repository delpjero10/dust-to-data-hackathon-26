# Home Connect API credentials (local only — gitignored, do not commit)
HOME_CONNECT_CLIENT_ID=your_client_id_here
HOME_CONNECT_CLIENT_SECRET=your_client_secret_here

# Optional: use the Home Connect simulator appliance for testing
USE_SIMULATOR=false

# AI layer — Bosch on-prem model (OpenAI-compatible endpoint, same one opencode uses)
# Copy the real values into your local .env (see opencode config: models.myprovider)
AI_BASE_URL=https://ews-emea.api.bosch.com/it/application/emea-ds3326-endp01/v1
AI_API_KEY=your_bosch_onprem_api_key_here
AI_MODEL=discretestack-stable

# Claude (Anthropic) as an alternative AI provider. Set AI_MODEL_PROVIDER=anthropic
# to use Claude instead of the Bosch on-prem model ("openai" = default).
AI_MODEL_PROVIDER=openai
AI_CLAUDE_BASE_URL=https://api.anthropic.com
AI_CLAUDE_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Smart Emptying (AI layer): minimum cleaning duration (seconds) before emptying the
# dust box is considered justified. Default 120 (= 2 min). See docs/ai-features.md.
AI_MIN_CLEAN_SECONDS=120
